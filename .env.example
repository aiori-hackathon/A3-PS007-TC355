# PrivacyGuard IPv6 - Environment Configuration
FLASK_APP=backend.app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-pv6-2026
PORT=5000
DATABASE_URL=sqlite:///backend/data/privacyguard.db

# Security & Detection Defaults
DEFAULT_TENANT=tenant-alpha
NDP_THRESHOLD=50
NDP_WINDOW_SECONDS=10
PSEUDONYM_LIFETIME_SECONDS=300
SESSION_LIFETIME_SECONDS=180
EVENT_RETENTION_DAYS=7
